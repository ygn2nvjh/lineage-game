{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lineage-game",
  "main": "src/cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "./dist-cloudflare/public", "binding": "ASSETS", "html_handling": "none", "run_worker_first": ["/", "/dungeon", "/ws", "/health"] },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "DungeonHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DungeonHub"] }]
}
