{
  "name": "lineage-game-mvp",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 127.0.0.1",
    "test": "node --test --test-isolation=none tests/core.test.mjs",
    "build": "node scripts/build.mjs",
    "test:online": "node --test --test-isolation=none tests/online.test.mjs",
    "build:online": "node scripts/build-online-worker.mjs",
    "test:latency": "node --test --test-isolation=none tests/online-latency.test.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev --ip 127.0.0.1",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "test:cloudflare": "node --test --test-isolation=none tests/cloudflare-hub.test.mjs",
    "test:adventure": "node --test --test-isolation=none tests/adventure-hub.test.mjs tests/solo-movement.test.mjs tests/actor-motion.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.154.0"
  }
}
